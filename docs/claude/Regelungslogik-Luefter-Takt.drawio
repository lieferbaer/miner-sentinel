<mxfile host="app.diagrams.net" modified="2026-10-24T09:00:00.000Z" agent="MinerSentinel" version="24.0.0" type="device"><diagram id="1_Hauptablauf" name="1 Hauptablauf"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="S1" value="Auslöser: Basisstufe gewählt · Automatik ein · Neustart des Miners · nach Wartung · nach Takt-Messung" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="280" height="90" as="geometry"/></mxCell><mxCell id="P1" value="Lernwert für die Basisstufe vorhanden?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="P2a" value="Starttakt = Lernwert" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="240" height="80" as="geometry"/></mxCell><mxCell id="P2b" value="Starttakt = Initialwert der Tabelle&lt;br&gt;(Stufe 1 = 100 … Stufe 10 = 190 MHz)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="80" as="geometry"/></mxCell><mxCell id="P3" value="Modus für den Starttakt nach Tabelle (ohne Spielraum); weicht er ab: Modus setzen, Übernahme prüfen&lt;br&gt;→ Unterdiagramm 4 Modus&lt;br&gt;Nach Neustart, Wartung oder Over Hot: keine Takterhöhung bis L, höchstens 10 min (Startpause)&lt;br&gt;Heizmodus: Lüfter Stufe 1, bis die Chiptemperatur L erreicht, dann Basisstufe (sofort bei Automatik aus, Miner antwortet nicht, Over Hot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="90" as="geometry"/></mxCell><mxCell id="P4" value="Takt senden, wenn er vom Takt laut Miner abweicht; Übernahme prüfen (Unterdiagramm 4)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="P5" value="Aktive Lüfterstufe = Basisstufe&lt;br&gt;→ Normalbetrieb" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="240" height="80" as="geometry"/></mxCell><mxCell id="Z1" value="Regelzyklus – Messen: Chiptemperatur (heißester Chip), Takt laut Miner, Modus, aktive Lüfterstufe" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="280" height="90" as="geometry"/></mxCell><mxCell id="Z2" value="Miner antwortet, Werte gültig, kein Over Hot?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="240" height="110" as="geometry"/></mxCell><mxCell id="Z2n" value="Keine Entscheidung, Lüfter unverändert, warten&lt;br&gt;→ Unterdiagramm 8 Situationen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="880" width="240" height="80" as="geometry"/></mxCell><mxCell id="Z3" value="Chiptemperatur ≥ 85 °C?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="240" height="110" as="geometry"/></mxCell><mxCell id="H" value="Hohe Chiptemperatur: Lüfter = Basisstufe + 1 / + 2, Takt − 5 … − 100 MHz (85–87 °C nach Aufenthalt), Korrekturphase beginnt&lt;br&gt;→ Unterdiagramm 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1000" width="240" height="110" as="geometry"/></mxCell><mxCell id="Z4" value="Korrekturphase?&lt;br&gt;(aktive Lüfterstufe über der Basisstufe)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="240" height="110" as="geometry"/></mxCell><mxCell id="Z4a" value="Eine Minute stabil in L–U, oder unter L?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="1120" width="240" height="110" as="geometry"/></mxCell><mxCell id="R" value="Rückkehr: aktive Lüfterstufe = Basisstufe&lt;br&gt;→ Normalbetrieb" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="1120" width="240" height="80" as="geometry"/></mxCell><mxCell id="K" value="Korrekturphase: keine Plus-Schritte; L–U keine Taktänderung (v2.0.6).&lt;br&gt;→ Unterdiagramm 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="1240" width="260" height="100" as="geometry"/></mxCell><mxCell id="F" value="Normalbetrieb – Feintuning (v2.0.6): L–U → keine Taktänderung · L−9 bis L−1 → + 5 (L−4 bis L−1: 3 min nach der letzten Erhöhung) · L−19 bis L−10 → + 20 · darunter → + 40 (kleinster Schritt 5 MHz) · Taktsperre 5 min nach Absenkung&lt;br&gt;→ Unterdiagramm 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="280" height="110" as="geometry"/></mxCell><mxCell id="Z6" value="Takt = 440 MHz und drei Minuten stabil unter 70 °C?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="240" height="110" as="geometry"/></mxCell><mxCell id="A" value="Ausnahme: aktive Lüfterstufe − 1&lt;br&gt;→ Unterdiagramm 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1480" width="240" height="80" as="geometry"/></mxCell><mxCell id="Z7" value="Taktänderung senden: Grenzen 100–440 MHz (unter 100: Fehler, nicht senden), Modus nach Regel&lt;br&gt;→ Unterdiagramm 4 · danach Beobachtungsfenster 30 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1600" width="280" height="100" as="geometry"/></mxCell><mxCell id="Z9" value="Lernen: 15-Minuten-Fenster prüfen&lt;br&gt;→ Unterdiagramm 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1720" width="240" height="80" as="geometry"/></mxCell><mxCell id="Z10" value="Protokoll und Reaktionszeiten&lt;br&gt;→ Unterdiagramm 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1840" width="240" height="80" as="geometry"/></mxCell><mxCell id="Z11" value="Nächster Regelzyklus" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1960" width="240" height="80" as="geometry"/></mxCell><mxCell id="1 H_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="S1" target="P1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e1" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P1" target="P2a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e2" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P1" target="P2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P2a" target="P3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P2b" target="P3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P3" target="P4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P4" target="P5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="P5" target="Z1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z1" target="Z2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e9" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z2" target="Z2n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z2n" target="Z10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="920"/><mxPoint x="600" y="1880"/></Array></mxGeometry></mxCell><mxCell id="1 H_e11" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z2" target="Z3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e12" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z3" target="H"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H" target="Z7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="1045"/><mxPoint x="620" y="1650"/></Array></mxGeometry></mxCell><mxCell id="1 H_e14" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z3" target="Z4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e15" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z4" target="Z4a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e16" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z4a" target="R"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="R" target="Z9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="1160"/><mxPoint x="1210" y="1760"/></Array></mxGeometry></mxCell><mxCell id="1 H_e18" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z4a" target="K"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="K" target="Z7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="1290"/><mxPoint x="930" y="1650"/></Array></mxGeometry></mxCell><mxCell id="1 H_e20" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z4" target="F"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="F" target="Z6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e22" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z6" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A" target="Z7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e24" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z6" target="Z7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z7" target="Z9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z9" target="Z10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z10" target="Z11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 H_e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Z11" target="Z1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="2000"/><mxPoint x="15" y="805"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="2_Hohe_Chiptemperatur" name="2 Hohe Chiptemperatur"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="H0" value="Chiptemperatur ≥ 85 °C&lt;br&gt;(jede Messung; Normalbetrieb und Korrekturphase)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="T" value="Tabelle (deine Vorgabe)&lt;br&gt;Vorher ab U+1 bis U+3: zwei Lüfterstöße (Basisstufe +1 für 6 s ab Bestätigung, dann zurück; ohne Bestätigung nach 30 s weiter) – zurück im Ziel: keine Senkung; ab U+4: Abbruch, sofort Tabelle; höchstens ein Stoßpaar je 10 min, neue erst nach ≤ U−1 (Nutzer 27.10.)&lt;br&gt;ab U+1: Lüfter + 1, Takt nach Aufenthalt in L–U davor: unter 5 min − 10, sonst − 5&lt;br&gt;ab U+2: + 1, Takt wie bei U+1&lt;br&gt;ab U+4: + 2, − 30&lt;br&gt;ab U+6: + 2, − 50&lt;br&gt;ab U+8: + 2, − 80&lt;br&gt;ab U+10: + 2, − 100&lt;br&gt;jede Schwelle höchstens 96 °C: ab 96 °C immer + 2, − 100 (Nutzer 27.10.)&lt;br&gt;Takt-Messung: fest wie bisher ab 85 °C&lt;br&gt;(Aufenthalt einmal beim Überschreiten von U gemessen, gilt bis zum Ende der Korrekturphase)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="240" height="150" as="geometry"/></mxCell><mxCell id="H2" value="Lüfter sofort = Basisstufe + 1 bzw. + 2 (höchstens 10, nie addieren) → Korrekturphase. Eine niedrigere Korrekturstufe erst, wenn die Tabelle sie 30 s lang verlangt." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="80" as="geometry"/></mxCell><mxCell id="H3" value="Takt = gesetzter Takt − Tabellenwert&lt;br&gt;(unter 100 MHz: Fehler, nicht senden)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="80" as="geometry"/></mxCell><mxCell id="H4" value="Takt sofort senden. Ist ein Moduswechsel nötig: Modus danach senden, dann Takt erneut senden&lt;br&gt;→ Unterdiagramm 4 Modus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="260" height="90" as="geometry"/></mxCell><mxCell id="H5" value="Beobachtungsfenster 30 Sekunden" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="H6" value="Chiptemperatur noch über der Schwelle und Tendenz (Wert vor höchstens 30 s) nicht fallend?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="240" height="110" as="geometry"/></mxCell><mxCell id="H7" value="Weiter im Regelzyklus&lt;br&gt;(Korrekturphase bis zur Rückkehr)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="240" height="80" as="geometry"/></mxCell><mxCell id="2 H_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H0" target="H2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 H_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H2" target="H3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 H_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H3" target="H4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 H_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H4" target="H5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 H_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H5" target="H6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 H_e5" value="ja: erneut, vom dann gesetzten Takt, Wert nach aktueller Chiptemperatur" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H6" target="H3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="695"/><mxPoint x="400" y="320"/></Array></mxGeometry></mxCell><mxCell id="2 H_e6" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="H6" target="H7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="3_Feinschritte" name="3 Feinschritte"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Fa" value="Zielbereich L–U (einstellbar: L ab 76, U bis 92 °C, 2–4 Grad; Start 82–85 °C; Nutzer 27.10.)&lt;br&gt;(Normalbetrieb und Korrekturphase)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="Fa2" value="Keine Taktänderung&lt;br&gt;(v2.0.6, Nutzer 25.10.; früher − 1 / − 2 MHz bei steigender Tendenz)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="260" height="110" as="geometry"/></mxCell><mxCell id="Fb" value="L−9 bis unter L&lt;br&gt;(nur Normalbetrieb)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="Fb1" value="Tendenz steigend?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="Fb2" value="Kein Schritt, warten" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="240" height="80" as="geometry"/></mxCell><mxCell id="Fb3" value="Schritt nach Chiptemperatur:&lt;br&gt;70–78 °C → + 5 MHz (bei 75–78 °C erst 3 min nach der letzten Takterhöhung)&lt;br&gt;(kleinster Taktschritt 5 MHz)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="260" height="100" as="geometry"/></mxCell><mxCell id="Fb4" value="Taktsperre aktiv?&lt;br&gt;(letzte Taktänderung über U, dann unter L: 5 min ab dem ersten Unterschreiten, einmal je Taktänderung; endet über U)&lt;br&gt;ja: kein Schritt, warten · nein: weiter" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="400" width="260" height="100" as="geometry"/></mxCell><mxCell id="Fb5" value="Schritt senden → Beobachtungsfenster 30 s" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="Fc" value="Unter 70 °C (nur Normalbetrieb):&lt;br&gt;60–69 °C → + 20 MHz&lt;br&gt;unter 60 °C → + 40 MHz&lt;br&gt;weiterer Schritt erst, wenn die Tendenz nicht steigend ist&lt;br&gt;nicht während der Taktsperre" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="Fd" value="Allgemein:&lt;br&gt;Tendenz = jetzt gegenüber dem Wert vor höchstens 30 s (bei jüngerer Taktänderung: deren Wert)&lt;br&gt;Minus-Schritte nur ab U+1 (Tabelle) bei Tendenz nicht fallend&lt;br&gt;Plus-Schritte nur unter L bei Tendenz nicht steigend&lt;br&gt;Startpause: nach Neustart, Wartung oder Over Hot keine Plus-Schritte bis L, höchstens 10 min" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="260" height="110" as="geometry"/></mxCell><mxCell id="3 F_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Fa" target="Fa2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 F_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Fb" target="Fb1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 F_e4" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Fb1" target="Fb2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 F_e5" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Fb1" target="Fb3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 F_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Fb3" target="Fb4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 F_e7" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Fb4" target="Fb5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="4_Modus" name="4 Modus"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="M0" value="Takt soll gesetzt werden" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="MR" value="Regel (deine Tabelle + Spielraum 20 MHz nach unten)&lt;br&gt;aufwärts: ab 361 → mode 03, ab 381 → mode 02, ab 401 → mode 01, ab 421 → mode 00&lt;br&gt;abwärts: bei 340 → mode 04, bei 360 → mode 03, bei 380 → mode 02, bei 400 → mode 01&lt;br&gt;beim Start: Tabelle ohne Spielraum&lt;br&gt;Moduswechsel stellt den Standardtakt des Modus ein (360/380/400/420/440)&lt;br&gt;Wechselst du den Modus selbst: Automatik arbeitet weiter" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="300" height="170" as="geometry"/></mxCell><mxCell id="M1" value="Hohe Chiptemperatur&lt;br&gt;(Unterdiagramm 2)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="M2" value="Takt sofort senden (wenn er vom Takt laut Miner abweicht)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="240" height="80" as="geometry"/></mxCell><mxCell id="M3" value="Modus nach Regel anders?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="240" height="110" as="geometry"/></mxCell><mxCell id="M7" value="Modus nach Regel anders?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="240" height="110" as="geometry"/></mxCell><mxCell id="M4" value="Modus senden" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="M5" value="Übernommen, sobald der Miner den neuen Modus meldet. Sonst erneut senden, bis es klappt." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="240" height="80" as="geometry"/></mxCell><mxCell id="M9" value="Zieltakt mit Takt laut Miner vergleichen. Gleich → kein Befehl, gilt als übernommen (z. B. Zieltakt = Standardtakt des Modus). Sonst Takt senden (bei hoher Chiptemperatur erneut)." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="260" height="110" as="geometry"/></mxCell><mxCell id="M10" value="Übernommen, sobald der Miner den gesetzten Wert meldet. Sonst erneut senden, bis es klappt." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="260" height="90" as="geometry"/></mxCell><mxCell id="M11" value="Beobachtungsfenster 30 s&lt;br&gt;Jeder Versuch im Protokoll" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="240" height="80" as="geometry"/></mxCell><mxCell id="4 M_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M0" target="M1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e1" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M1" target="M2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M2" target="M3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e3" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M3" target="M4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e4" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M3" target="M10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="335"/><mxPoint x="620" y="925"/></Array></mxGeometry></mxCell><mxCell id="4 M_e5" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M1" target="M7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e6" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M7" target="M4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e7" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M7" target="M9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M4" target="M5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M5" target="M9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M9" target="M10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 M_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="M10" target="M11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="5_Ausnahme_Lüfterreduzierung" name="5 Ausnahme Lüfterreduzierung"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="A0" value="Normalbetrieb&lt;br&gt;(Basisstufe 1–7)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="A1" value="Takt = 440 MHz?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="A2" value="Chiptemperatur drei Minuten stabil unter 70 °C?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="110" as="geometry"/></mxCell><mxCell id="A9" value="Keine Ausnahme" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="240" height="80" as="geometry"/></mxCell><mxCell id="A3" value="Aktive Lüfterstufe − 1 (nicht unter Stufe 1)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="240" height="80" as="geometry"/></mxCell><mxCell id="A4" value="Drei Minuten Stabilität prüfen" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="A5" value="Weiter unter 70 °C und Takt 440 MHz?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="240" height="110" as="geometry"/></mxCell><mxCell id="A6" value="Ende der Ausnahme (Chiptemperatur über 70 °C): aktive Lüfterstufe bleibt reduziert, Normalbetrieb regelt den Takt weiter" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="260" height="90" as="geometry"/></mxCell><mxCell id="A7" value="Zurück zu höheren Stufen nur über Hohe Chiptemperatur (Basisstufe + 1 / + 2).&lt;br&gt;Die Ausnahme beginnt jederzeit neu, sobald die Bedingungen wieder erfüllt sind.&lt;br&gt;Die Basisstufe bleibt gespeichert." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="300" height="100" as="geometry"/></mxCell><mxCell id="5 A_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A0" target="A1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e1" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A1" target="A9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e2" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e3" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A2" target="A9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e4" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A3" target="A4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A4" target="A5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e7" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A5" target="A3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="695"/><mxPoint x="380" y="440"/></Array></mxGeometry></mxCell><mxCell id="5 A_e8" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A5" target="A6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="A6" target="A7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="6_Lernen" name="6 Lernen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L0" value="Jeder Regelzyklus" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="L1" value="Chiptemperatur in L–U (Ausflüge bis 60 s erlaubt), keine Korrekturphase, Lüfterstufe und Modus unverändert?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="L2" value="Lernfenster neu starten&lt;br&gt;(Lüfterwechsel, Moduswechsel, ab U+1 oder länger als 60 s außerhalb L–U)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="240" height="80" as="geometry"/></mxCell><mxCell id="L3" value="15 Minuten erreicht?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="110" as="geometry"/></mxCell><mxCell id="L4" value="Fenster läuft weiter" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="240" height="80" as="geometry"/></mxCell><mxCell id="L5" value="Mittelwert der Chiptemperatur der 15 Minuten berechnen" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="240" height="80" as="geometry"/></mxCell><mxCell id="L6" value="Lernwert der aktiven Lüfterstufe = gesetzter Takt, Temperaturmittel, Zeitstempel, Anzahl + 1&lt;br&gt;(ersetzt den alten Wert)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="260" height="100" as="geometry"/></mxCell><mxCell id="L7" value="Lernwerte je Lüfterstufe&lt;br&gt;(Datenbank)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="240" height="80" as="geometry"/></mxCell><mxCell id="L8" value="Protokoll: Lernwert gespeichert" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="240" height="80" as="geometry"/></mxCell><mxCell id="L9" value="Keine Übertragung zwischen Lüfterstufen.&lt;br&gt;Beim nächsten Start der Stufe: Starttakt = dieser Lernwert." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="260" height="80" as="geometry"/></mxCell><mxCell id="6 L_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L0" target="L1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e1" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e2" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L1" target="L3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e3" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e4" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L3" target="L5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L6" target="L7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 L_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="L7" target="L8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="7_Protokoll_und_Reaktionszeiten" name="7 Protokoll und Reaktionszeiten"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Q0" value="Jeder Befehl (Modus, Takt, Lüfter) und jede Entscheidung" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="Q1" value="Eintrag: Datum/Uhrzeit, Art, Auslöser, Chiptemperatur, alt → neu, Befehl/Endpunkt, Antwort (ohne Zugangsdaten), Ergebnis oder Fehler, API-Reaktionszeit" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="280" height="110" as="geometry"/></mxCell><mxCell id="Q2" value="Übernahmezeit: erste Meldung des Miners (Modus gemeldet bzw. Takt laut Miner geändert); nicht erkennbar → „nicht gemessen“" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="280" height="100" as="geometry"/></mxCell><mxCell id="Q3" value="Thermische Reaktionszeit: Chiptemperatur vor der Änderung und Verlauf danach" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="80" as="geometry"/></mxCell><mxCell id="Q4" value="Protokoll (Datenbank)&lt;br&gt;bleibt nach Neustart" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="Q5" value="Protokollseite: chronologisch, Fehler hervorgehoben, Filter nach Art / Erfolg / Fehler, Detailansicht mit API-Antworten, Reaktionszeiten" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="280" height="100" as="geometry"/></mxCell><mxCell id="Q6" value="Auswertung je Modus, Moduswechsel und Taktwert: Anzahl, durchschnittliche Reaktionszeiten" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="260" height="90" as="geometry"/></mxCell><mxCell id="Q7" value="Nur ohnehin gesendete Befehle. Keine Änderungen zur Messung provozieren. Ressourcenschonend, Regelung geht vor." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="260" height="90" as="geometry"/></mxCell><mxCell id="7 P_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Q0" target="Q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 P_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Q1" target="Q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 P_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Q2" target="Q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 P_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Q3" target="Q4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 P_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Q4" target="Q5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 P_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="Q4" target="Q6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="8_Situationen_und_Fehler" name="8 Situationen und Fehler"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="X0a" value="Neustart des Miners" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="280" height="70" as="geometry"/></mxCell><mxCell id="X0b" value="Hauptablauf von vorn: Starttakt = Lernwert, sonst Initialwert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="420" height="70" as="geometry"/></mxCell><mxCell id="X1a" value="Miner ändert den Takt selbst" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="280" height="70" as="geometry"/></mxCell><mxCell id="X1b" value="gesetzten Takt erneut senden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="420" height="70" as="geometry"/></mxCell><mxCell id="X2a" value="Over Hot" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="280" height="70" as="geometry"/></mxCell><mxCell id="X2b" value="Messwerte nicht verwenden, keine Entscheidung bis zu gültigen Werten; Neustart-Button bleibt; danach Hauptablauf von vorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="420" height="70" as="geometry"/></mxCell><mxCell id="X3a" value="Miner antwortet nicht (Mining-Schnittstelle)&lt;br&gt;Nur die Einstellungsseite nicht: weiter regeln, Moduswechsel wartet" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="70" as="geometry"/></mxCell><mxCell id="X3b" value="Lüfter unverändert, warten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="400" width="420" height="70" as="geometry"/></mxCell><mxCell id="X4a" value="Lüftersteuerung antwortet nicht oder meldet andere Stufe" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="280" height="70" as="geometry"/></mxCell><mxCell id="X4b" value="Stufe erneut senden, bis es klappt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="420" height="70" as="geometry"/></mxCell><mxCell id="X5a" value="Takt-Messung (Messreihe, Max-Messung)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="280" height="70" as="geometry"/></mxCell><mxCell id="X5b" value="Taktregelung pausiert; Lüfter reagiert nach Hohe Chiptemperatur; danach Hauptablauf von vorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="420" height="70" as="geometry"/></mxCell><mxCell id="X6a" value="Drosselung (manueller Takt)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="280" height="70" as="geometry"/></mxCell><mxCell id="X6b" value="wird abgeschafft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="760" width="420" height="70" as="geometry"/></mxCell><mxCell id="X7a" value="Wartung" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="280" height="70" as="geometry"/></mxCell><mxCell id="X7b" value="Lüfter aus, wenn der Miner aus ist; beim Wiedereinschalten Hauptablauf von vorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="880" width="420" height="70" as="geometry"/></mxCell><mxCell id="X8a" value="Automatik ein / aus" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="280" height="70" as="geometry"/></mxCell><mxCell id="X8b" value="ein = Hauptablauf von vorn; aus = Takt bleibt, wie er ist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1000" width="420" height="70" as="geometry"/></mxCell><mxCell id="X9a" value="Moduswechsel durch dich" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="280" height="70" as="geometry"/></mxCell><mxCell id="X9b" value="Automatik arbeitet weiter; nächstes Taktsetzen folgt der Modus-Regel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1120" width="420" height="70" as="geometry"/></mxCell><mxCell id="X10a" value="Takt unter 100 MHz berechnet" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="280" height="70" as="geometry"/></mxCell><mxCell id="X10b" value="nicht senden, Fehler im Protokoll, zuletzt gesetzter Takt bleibt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1240" width="420" height="70" as="geometry"/></mxCell><mxCell id="X11a" value="Modus / Takt / Lüfter nicht übernommen" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="280" height="70" as="geometry"/></mxCell><mxCell id="X11b" value="erneut senden, bis es klappt; jeder Versuch im Protokoll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1360" width="420" height="70" as="geometry"/></mxCell><mxCell id="X12a" value="Zieltakt = Takt laut Miner (z. B. Automatik ein bei laufendem Takt, Standardtakt nach Moduswechsel)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="280" height="70" as="geometry"/></mxCell><mxCell id="X12b" value="kein Taktbefehl, gilt als übernommen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1480" width="420" height="70" as="geometry"/></mxCell><mxCell id="8 S_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettyS